{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "deck-static",
      "autoPort": true,
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const http=require('http'),fs=require('fs'),p=require('path');http.createServer((q,s)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u==='/')u='/slides.html';let f=p.join(process.cwd(),u);fs.readFile(f,(e,d)=>{if(e){s.statusCode=404;s.end('nf');return;}s.setHeader('Content-Type',u.endsWith('.html')?'text/html':'application/octet-stream');s.end(d);});}).listen(process.env.PORT||8099,()=>console.log('deck on',process.env.PORT||8099));"
      ],
      "port": 8099
    }
  ]
}
